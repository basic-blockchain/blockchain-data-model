# Blockchain Data Model — Environment Configuration
# Copy this file to .env and adjust values for your local setup.

# Persistence backend: "json" (default) or "postgres"
PERSISTENCE_BACKEND=postgres

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blockchain_data_model

# Connection pool settings
PG_POOL_MIN=1
PG_POOL_MAX=5
